# ──────────────────────────────────────────────────────────────────────
# InvestingLab — environment configuration
#
# Copy to `.env` (git-ignored) and fill in the values. Every variable is read by
# `investinglab.config.Settings`; invalid values abort start-up with a clear error.
# Never commit real secrets.
# ──────────────────────────────────────────────────────────────────────

# Environment: local | test | staging | production
INVESTINGLAB_ENVIRONMENT=local

# Logging: level DEBUG | INFO | WARNING | ERROR | CRITICAL
INVESTINGLAB_LOG_LEVEL=INFO
# Format: console | json. Leave empty to use console locally and json elsewhere.
INVESTINGLAB_LOG_FORMAT=

# Root directory of the local market-data cache and exports.
INVESTINGLAB_DATA_DIR=data
