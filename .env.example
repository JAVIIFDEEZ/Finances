# ──────────────────────────────────────────────────────────────────────
# InvestingLab — environment configuration
#
# Copy to `.env` (git-ignored) and fill in the values. Every variable is read by
# `investinglab.config.Settings`; invalid values abort start-up with a clear error.
# Never commit real secrets.
# ──────────────────────────────────────────────────────────────────────

# Environment: local | test | staging | production
INVESTINGLAB_ENVIRONMENT=local

# Logging: level DEBUG | INFO | WARNING | ERROR | CRITICAL
INVESTINGLAB_LOG_LEVEL=INFO
# Format: console | json. Leave empty to use console locally and json elsewhere.
INVESTINGLAB_LOG_FORMAT=

# Root directory of the local market-data cache and exports.
INVESTINGLAB_DATA_DIR=data

# Market-data cache directory (default: <DATA_DIR>/cache).
INVESTINGLAB_CACHE_DIR=

# Outbound HTTP: timeout per request (seconds) and attempts for transient errors.
INVESTINGLAB_HTTP_TIMEOUT_SECONDS=30
INVESTINGLAB_HTTP_MAX_ATTEMPTS=4
# Maximum number of series downloaded concurrently.
INVESTINGLAB_MAX_CONCURRENCY=8

# ── Provider credentials (never commit real values) ───────────────────
# FRED / ALFRED (macro, rates, FX, point-in-time vintages): https://fred.stlouisfed.org/docs/api/api_key.html
INVESTINGLAB_FRED_API_KEY=
# Alpha Vantage (second price source): https://www.alphavantage.co/support/#api-key
INVESTINGLAB_ALPHAVANTAGE_API_KEY=
